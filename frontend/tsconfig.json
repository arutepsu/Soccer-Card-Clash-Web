{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",

    "allowJs": true,
    "checkJs": false,
    "strict": false,

    "moduleResolution": "node",
    "esModuleInterop": true,

    "rootDir": "src",
    "outDir": "./dist-ts",

    "sourceMap": true,
    "skipLibCheck": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ]
}

